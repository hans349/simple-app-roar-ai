# Copy to .env.local for local development. Never commit the filled-in file.
# On the platform, set these as environment variables in the app config instead.

# --- Database -----------------------------------------------------------------
# Postgres connection string. The platform injects this when the database
# toggle is on; the app also accepts POSTGRES_URL / PG_CONNECTION_STRING.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Email --------------------------------------------------------------------
# The address emails are sent from. The platform injects this.
EMAIL_FROM=noreply@example.com

# Option A — SMTP (used when SMTP_HOST is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Option B — Resend HTTP API (used when SMTP_HOST is empty)
RESEND_API_KEY=

# --- Diagnostics (optional) ---------------------------------------------------
# Unlocks GET /api/diag and POST /api/email/probe, which help debug a host
# without shell access. Both return 404 while this is unset. Any random string:
#   openssl rand -hex 16
PROBE_TOKEN=

# --- Platform metadata (optional, informational only) -------------------------
APP_NAME=simple-app-roar-ai
APP_ENVIRONMENT=development
APP_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
